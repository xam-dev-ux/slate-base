# Chain / RPC
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# Deployed contracts (fill in after `make deploy-factory-mainnet` / `make deploy-funds-mainnet`)
NEXT_PUBLIC_FACTORY_ADDRESS=
# Optional explicit fund list, comma separated. Useful before the factory is indexed.
NEXT_PUBLIC_FUND_ADDRESSES=

NEXT_PUBLIC_APP_URL=

# Base Builder Code — register at dashboard.base.org. Attached to swaps as an ERC-8021
# calldata suffix. Optional: with it unset, swaps still work, just without attribution.
NEXT_PUBLIC_BUILDER_CODE=

# WalletConnect (optional; the injected and Coinbase Wallet connectors work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Hides the "Pricing mode" panel (TWAP-fallback status + operator toggle) on the fund page when
# set to "false". The underlying feature is a per-fund contract setting either way — this only
# controls whether its UI surface is shown. Defaults to shown.
NEXT_PUBLIC_SHOW_PRICING_MODE_UI=

