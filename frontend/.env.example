# Chain / RPC
NEXT_PUBLIC_CHAIN_ID=8453
# Optional. Defaults to the public https://mainnet.base.org endpoint, which rate-limits
# aggressively under real dApp traffic (see lib/config.ts). Point this at a dedicated provider
# (Alchemy, QuickNode, etc.) instead once you have one — a free tier is enough.
NEXT_PUBLIC_RPC_URL=

# Optional, separate from NEXT_PUBLIC_RPC_URL above. eth_getLogs range caps vary a lot by
# provider — Alchemy's free tier allows only 10 blocks per call, vs. 10,000 on the public
# endpoint — so a provider picked above for its generous eth_call limits may be nearly unusable
# for the multi-hundred-thousand-block log scans this app does (rebalance history, corporate
# actions). Defaults to the public endpoint, which handles wide log ranges fine even though it
# rate-limits eth_call heavily. Only set this if you have a provider whose free tier supports a
# wide eth_getLogs range too.
NEXT_PUBLIC_LOGS_RPC_URL=

# Deployed contracts (fill in after `make deploy-factory-mainnet` / `make deploy-funds-mainnet`)
NEXT_PUBLIC_FACTORY_ADDRESS=
# Optional explicit fund list, comma separated. Useful before the factory is indexed.
NEXT_PUBLIC_FUND_ADDRESSES=

NEXT_PUBLIC_APP_URL=

# Base Builder Code — register at base.dev. Attached to every transaction as an ERC-8021
# calldata suffix, via wagmi's client-level dataSuffix (see lib/config.ts). Optional: with it
# unset, transactions still work, just without attribution.
NEXT_PUBLIC_BUILDER_CODE=

# WalletConnect (optional; the injected and Coinbase Wallet connectors work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Hides the "Pricing mode" panel (TWAP-fallback status + operator toggle) on the fund page when
# set to "false". The underlying feature is a per-fund contract setting either way — this only
# controls whether its UI surface is shown. Defaults to shown.
NEXT_PUBLIC_SHOW_PRICING_MODE_UI=

